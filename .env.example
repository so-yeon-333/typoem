PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
DB_PATH=./typoem.db
NODE_ENV=development

# Render (production) notes:
#   - PORT is auto-injected by Render, do not set
#   - DB_PATH is not set on Render (uses default ./typoem.db, ephemeral on free tier)
#   - NODE_ENV=production
#   - JWT_SECRET should be a different long random string from local