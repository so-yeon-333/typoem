{
  "name": "typoem",
  "version": "0.1.0",
  "description": "A cozy little corner where friends gather to read a daily poem and leave their ink-marks across the page.",
  "main": "app.js",
  "type": "commonjs",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "fetch-poems": "node scripts/fetch-poems.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/setup.js"]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/so-yeon-333/typoem.git"
  },
  "keywords": [
    "poetry",
    "web",
    "express",
    "sqlite"
  ],
  "author": "Team 5 (Sihyun, Jiseop, Gyeongyoon, Soyeon)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/so-yeon-333/typoem/issues"
  },
  "homepage": "https://github.com/so-yeon-333/typoem#readme",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
